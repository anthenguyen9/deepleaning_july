SERPAPI_API_KEY=
SERPAPI_DAILY_LIMIT=30
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ASSISTANT_MODEL=gemini-3.5-flash-lite
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5.6-luna
ASSISTANT_OPENAI_FALLBACK=0
ASSISTANT_REFRESH_ON_QUERY=0
AUTO_BUILD_DENSE=0
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-before-first-run
FLASK_SECRET_KEY=
# Optional stable cookie name when moving a checkout between drives:
# SESSION_COOKIE_NAME=foodlens_demo
# Public deployment only (leave unset for local use):
# DEPLOYMENT_MODE=public
# PUBLIC_HOSTS=your-domain.up.railway.app
# DATABASE_PATH=/app/instance/food_reviews.sqlite3
# MODEL_PATH=/app/instance/baseline.joblib
# DEMO_ACCESS_PASSWORD=          # optional extra HTTP Basic password for a temporary shared demo
# DEMO_AUTO_LOGIN_USERNAME=demo_user  # optional, requires DEMO_ACCESS_PASSWORD and an existing user
